# ---- generator + judge (free Groq tier works; the judge must be a DIFFERENT model than the generator) ----
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b
LLM_MIN_INTERVAL=6            # seconds between calls (free-tier rate limits)
PROMPT_PASSAGES=4             # evidence chunks shown to the model (3 per sub-query for multi-part questions)
# LLM_REASONING_EFFORT=low    # gpt-oss: low | medium | high
# LLM_MAX_WAIT=90             # a rate-limit wait longer than this aborts the run instead of sleeping
# ---- retrieval (auto = best installed backend, falls back to dependency-free ones) ----
CHUNK_MAX_CHARS=900           # sized for long regulatory paragraphs; the synthetic demo uses 400
EMBEDDER=auto
RERANKER=auto
VECTOR_STORE=auto
