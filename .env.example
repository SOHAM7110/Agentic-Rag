# Generator: offline | groq | hf | ollama | openai   (offline = rule-based, zero cost, no network)
LLM_PROVIDER=offline
LLM_MODEL=
GROQ_API_KEY=
HF_TOKEN=
# Judge MUST be a different model from the generator for real numbers
JUDGE_PROVIDER=offline
JUDGE_MODEL=
# Retrieval backends: auto picks the best installed (st/chroma/cross-encoder) and falls back otherwise
EMBEDDER=auto
RERANKER=auto
VECTOR_STORE=auto
MAX_LOOPS=3
TOKEN_BUDGET=8000
